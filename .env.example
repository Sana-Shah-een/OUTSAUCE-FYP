# ========================
# Supabase
# ========================
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ========================
# NestJS API
# ========================
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001

# ========================
# n8n Integration
# ========================
N8N_WEBHOOK_URL=http://localhost:5678/webhook/outsauce-scrape
N8N_WEBHOOK_SECRET=change-me

# ========================
# Stripe (Billing)
# ========================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ========================
# AI (Google Gemini)
# ========================
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Optional: override the default model (gemini-1.5-pro)
# GEMINI_MODEL=gemini-1.5-pro

# ========================
# Google OAuth
# ========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========================
# SMTP (Email)
# ========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# ========================
# App
# ========================
NODE_ENV=development
